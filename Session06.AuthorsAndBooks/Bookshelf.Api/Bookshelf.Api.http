@baseUrl = http://localhost:5086

### Get authors
GET {{baseUrl}}/api/author

### Get author
GET {{baseUrl}}/api/author/1

### Get author's books
GET {{baseUrl}}/api/author/1/books

### Create author
POST {{baseUrl}}/api/author
Content-Type: application/json

{
  "name": "Terry Pratchett"
}

### Update author
PUT {{baseUrl}}/api/author/1
Content-Type: application/json

{
  "name": "Sir Terry Pratchett"
}

### Delete author
DELETE {{baseUrl}}/api/author/1

### Get books
GET {{baseUrl}}/api/book

### Get book
GET {{baseUrl}}/api/book/1

### Create book
POST {{baseUrl}}/api/book
Content-Type: application/json

{
  "title": "Mort",
  "authorId": 1,
  "isbn": "9780552131063",
  "publishedYear": 1987
}

### Update book
PUT {{baseUrl}}/api/book/1
Content-Type: application/json

{
  "title": "Mort (revised)",
  "authorId": 1,
  "isbn": "9780552131063",
  "publishedYear": 1987
}

### Delete book
DELETE {{baseUrl}}/api/book/1
