@baseUrl = http://localhost:5087

### Get teams
GET {{baseUrl}}/api/team

### Get team
GET {{baseUrl}}/api/team/1

### Create team
POST {{baseUrl}}/api/team
Content-Type: application/json

{
  "name": "Kaizer Chiefs",
  "city": "Johannesburg"
}

### Update team
PUT {{baseUrl}}/api/team/1
Content-Type: application/json

{
  "name": "Kaizer Chiefs",
  "city": "Soweto"
}

### Delete team
DELETE {{baseUrl}}/api/team/1

### Get players
GET {{baseUrl}}/api/player

### Get player
GET {{baseUrl}}/api/player/1

### Get team's players
GET {{baseUrl}}/api/player/team/1

### Create player
POST {{baseUrl}}/api/player
Content-Type: application/json

{
  "name": "Itumeleng Khune",
  "shirtNumber": 32,
  "position": "Goalkeeper",
  "teamId": 1
}

### Update player
PUT {{baseUrl}}/api/player/1
Content-Type: application/json

{
  "name": "Itumeleng Khune",
  "shirtNumber": 1,
  "position": "Goalkeeper",
  "teamId": 1
}

### Delete player
DELETE {{baseUrl}}/api/player/1
