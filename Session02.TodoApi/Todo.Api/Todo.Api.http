@baseUrl = http://localhost:5082

### Add todo
POST {{baseUrl}}/todos
Content-Type: application/json

{
  "title": "test"
}


### update 
PUT {{baseUrl}}/todos/3
Content-Type: application/json

{
  "title": "Buy groceries and milk",
  "isCompleted": true
}

### CompleteToggle
PATCH {{baseUrl}}/todos/2/completeToggle


### get by id
GET {{baseUrl}}/todos/6


### delete by id
DELETE {{baseUrl}}/todos/1

### get all
GET {{baseUrl}}/todos

### get all completed
GET {{baseUrl}}/todos/completed